{
  "name": "analysis-board",
  "productName": "Analysis Board",
  "version": "2.1.0",
  "description": "Chess analysis and training app for Mac with Stockfish 18: diagnosis of your mistakes, threats, puzzles, endgames and a daily plan. In English and Spanish.",
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "package:mac": "bash scripts/package-mac.sh",
    "test": "bash scripts/test.sh",
    "test:ui": "bash scripts/test-ui.sh"
  },
  "keywords": [
    "ajedrez",
    "chess",
    "stockfish",
    "electron",
    "lichess",
    "chess.com",
    "entrenamiento"
  ],
  "author": "juanazzurro",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/juanazzurro/analysis-board",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanazzurro/analysis-board.git"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/asap": "^5.3.0",
    "@fontsource-variable/chivo-mono": "^5.3.0",
    "@fontsource-variable/piazzolla": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "electron": "^45.3.0",
    "esbuild": "^0.28.2"
  }
}
